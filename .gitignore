# Godot 4+ specific ignores
.godot/
/build/
*.keystore
*.jks

/android/build/build/
/android/build/.gradle/
/android/build/local.properties

/android/build/libs/debug/*.aar
/android/build/libs/release/*.aar
/android/build/libs/dev/*.aar

# Test project build output
tests/**/bin/
tests/**/obj/

# Online server build output and any local database (the real one lives only on the server).
# Not "server/**/data/": Windows matches that case-blind and would hide server/.../Data/.
server/**/bin/
server/**/obj/
*.db
*.db-shm
*.db-wal

# Claude preview renders and scratch output (not game assets)
/Claude outputs/

# cardgen scratch output (featuregen/logogen inputs and outputs)
tools/cardgen/renders/
tools/cardgen/brand_out/

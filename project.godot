; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="CardGame2"
run/main_scene="uid://b7qn5xyxoj23q"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[display]

; Base is a 720px square: with aspect "expand" the SHORT side of any screen becomes 720
; design-pixels and the long side grows, so the UI is the same physical size in portrait
; (720x~1560 on a phone) and landscape (1280x720 on desktop). See GameManager.ApplyResponsiveLayout.
window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom="res://ui_theme.tres"

[dotnet]

project/assembly_name="CardGame2"

[rendering]

environment/defaults/default_clear_color=Color(0.07, 0.24, 0.13, 1)

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

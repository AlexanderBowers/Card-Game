<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the game's rules, with no Godot in the loop: the rules and profile classes are
    plain C#, so they are compiled straight in from the project root.

    Run from the repo root:   dotnet test tests/AimFor20.Tests

    The game's own AimFor20.csproj leaves tests/ out of its build (Compile Remove), and
    tests/.gdignore keeps the Godot editor from importing anything in here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Card.cs" Link="Game/Card.cs" />
    <Compile Include="../../Speech.cs" Link="Game/Speech.cs" />
    <Compile Include="../../Player.cs" Link="Game/Player.cs" />
    <Compile Include="../../GameState.cs" Link="Game/GameState.cs" />
    <Compile Include="../../CardEffects.cs" Link="Game/CardEffects.cs" />
    <Compile Include="../../ModifierDef.cs" Link="Game/ModifierDef.cs" />
    <Compile Include="../../Ladder.cs" Link="Game/Ladder.cs" />
    <Compile Include="../../CollectionLog.cs" Link="Game/CollectionLog.cs" />
    <Compile Include="../../Cosmetics.cs" Link="Game/Cosmetics.cs" />
    <Compile Include="../../Ruleset.cs" Link="Game/Ruleset.cs" />
    <!-- RunData is split across files; only RankTheme.cs (the rank colours) needs Godot and stays out. -->
    <Compile Include="../../RunData.cs" Link="Game/RunData.cs" />
    <Compile Include="../../RunData.Save.cs" Link="Game/RunData.Save.cs" />
    <Compile Include="../../RunData.Migration.cs" Link="Game/RunData.Migration.cs" />
    <Compile Include="../../Table.cs" Link="Game/Table.cs" />
    <Compile Include="../../DrawAssist.cs" Link="Game/DrawAssist.cs" />
    <Compile Include="../../SetRules.cs" Link="Game/SetRules.cs" />
    <Compile Include="../../Bot.cs" Link="Game/Bot.cs" />
    <Compile Include="../../DeckOdds.cs" Link="Game/DeckOdds.cs" />
    <Compile Include="../../CloudBundle.cs" Link="Game/CloudBundle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
